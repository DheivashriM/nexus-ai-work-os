# ==============================================================================
# Nexus AI Work Operating System — Root Environment Variables
#
# LOCAL DEV:  Copy to .env and fill in values.
# RENDER:     Set these in Dashboard → service → Environment tab.
# ==============================================================================

# ── Database (Render auto-injects for backend) ───────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security ─────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── LLM Provider ('rule_based', 'gemini', 'openai') ─────────────────────
LLM_PROVIDER=rule_based
VITE_LLM_PROVIDER=rule_based
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-pro
VITE_LLM_MODEL=gemini-1.5-pro

# ── Server ───────────────────────────────────────────────────────────────
APP_ENV=production
PORT=8000
FRONTEND_URL=https://nexus-frontend.onrender.com
NEXUS_PUBLIC_API_URL=https://nexus-api.onrender.com

# ── n8n Automation ───────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pmtool-events
N8N_WEBHOOK_SECRET=pmtool_startup_secure_hmac_secret_2026_key

# ── Meta WhatsApp Business Cloud API (Optional) ─────────────────────────
META_WA_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_permanent_access_token
META_WA_VERIFY_TOKEN=your_private_webhook_verify_token
META_APP_SECRET=your_meta_app_secret_for_hmac_signature
