# ==============================================================================
# AI PM / Nexus AI Work Operating System — Environment Variables Example
# Copy this file to .env before starting. On Render, set these in the dashboard.
# ==============================================================================

# Database Configuration (PostgreSQL required for production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security & Authentication (CHANGE SECRET_KEY for production!)
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Supported providers: 'rule_based' (default offline), 'gemini', 'openai'
LLM_PROVIDER=rule_based
VITE_LLM_PROVIDER=rule_based

# Gemini Provider API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Provider API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Name (Optional override)
LLM_MODEL=gemini-1.5-pro
VITE_LLM_MODEL=gemini-1.5-pro

# Server Configuration
APP_ENV=production
PORT=8000
FRONTEND_URL=https://your-frontend-url.onrender.com

# Meta WhatsApp Business Cloud API Configuration
META_WA_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_permanent_access_token
META_WA_VERIFY_TOKEN=your_private_webhook_verify_token
META_APP_SECRET=your_meta_app_secret_for_hmac_signature

# Automation & Integrations (n8n / Email)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pmtool-events
