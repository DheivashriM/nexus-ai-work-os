{
  "name": "PMTool - Blocker Emergency WhatsApp & Slack Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pmtool-events",
        "options": {
          "rawBody": true
        }
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"body\"][\"event_type\"]}}",
              "value2": "BLOCKER_RAISED"
            }
          ]
        }
      },
      "name": "Filter Blocker Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "channel": "#critical-blockers",
        "text": "🚨 *CRITICAL BLOCKER REPORTED*\n*Task:* ={{$json[\"body\"][\"data\"][\"task_title\"]}}\n*Severity:* ={{$json[\"body\"][\"data\"][\"severity\"]}}\n*Reported By:* ={{$json[\"body\"][\"data\"][\"reported_by\"]}}\n*Issue:* ={{$json[\"body\"][\"data\"][\"description\"]}}"
      },
      "name": "Post to Slack Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [700, 200]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Filter Blocker Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Blocker Event": {
      "main": [
        [
          {
            "node": "Post to Slack Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
