# Backend Environment Variables — Copy to .env or set in Render dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration ('rule_based', 'gemini', 'openai')
LLM_PROVIDER=rule_based
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-pro

APP_ENV=production
PORT=8000
FRONTEND_URL=https://your-frontend-url.onrender.com

# Meta WhatsApp Business Cloud API
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_access_token
META_WA_VERIFY_TOKEN=generate_a_private_random_value
META_APP_SECRET=your_meta_app_secret
META_WA_API_BASE_URL=https://graph.facebook.com/v23.0
NEXUS_PUBLIC_API_URL=https://your-backend-url.onrender.com
