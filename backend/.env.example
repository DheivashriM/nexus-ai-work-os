# ==============================================================================
# Nexus AI Work Operating System — Environment Variables
#
# LOCAL DEV:  Copy this file to .env and fill in your values.
# RENDER:     Set these in Dashboard → nexus-api → Environment tab.
#             DATABASE_URL and SECRET_KEY are auto-set by the blueprint.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────
# Render auto-injects this from the nexus-db PostgreSQL resource.
# For local dev, use SQLite (default) or your own PostgreSQL instance.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Security & Auth ──────────────────────────────────────────────────────
# Render auto-generates SECRET_KEY via the blueprint.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Application Mode ────────────────────────────────────────────────────
APP_ENV=production
PORT=8000

# ── Frontend URL (for CORS allowlisting) ─────────────────────────────────
FRONTEND_URL=https://nexus-frontend.onrender.com

# ── Public Backend URL (for WhatsApp webhook registration) ───────────────
NEXUS_PUBLIC_API_URL=https://nexus-api.onrender.com

# ── LLM / AI Provider ───────────────────────────────────────────────────
# Supported: 'rule_based' (default, no API key needed), 'gemini', 'openai'
LLM_PROVIDER=rule_based
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-pro

# ── n8n Automation Webhook ───────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/pmtool-events
N8N_WEBHOOK_SECRET=pmtool_startup_secure_hmac_secret_2026_key

# ── Meta WhatsApp Business Cloud API (Optional) ─────────────────────────
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_ACCESS_TOKEN=your_meta_system_user_access_token
META_WA_VERIFY_TOKEN=generate_a_private_random_value
META_APP_SECRET=your_meta_app_secret
META_WA_API_BASE_URL=https://graph.facebook.com/v23.0
